				<Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://github.com/akhil-prajapati/ninja-runner/issues" />
				<Property Id="Microsoft.VisualStudio.Services.Links.Learn" Value="https://github.com/akhil-prajapati/ninja-runner#readme" />
				<Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#1e1e1e" />
