{
  "name": "ninja-runner",
  "displayName": "🥷 Ninja Runner",
  "description": "⚡ Universal development server runner - Auto-detect and run any frontend/backend projects",
  "version": "0.1.2",
  "publisher": "akhilninja",
  "icon": "ninja-server-icon.png",
  "engines": {
    "vscode": "^1.50.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/akhil-prajapati/ninja-runner"
  },
  "homepage": "https://github.com/akhil-prajapati/ninja-runner#readme",
  "bugs": {
    "url": "https://github.com/akhil-prajapati/ninja-runner/issues"
  },
  "keywords": [
    "ninja",
    "server",
    "runner",
    "development",
    "frontend",
    "backend",
    "react",
    "nextjs",
    "spring-boot",
    "maven",
    "npm",
    "universal",
    "auto-detect"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "serverRunner": [
        {
          "id": "serverRunnerView",
          "name": "🥷 Ninja Runner",
          "when": "serverRunnerEnabled"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "serverRunner",
          "title": "🥷 Ninja Runner",
          "icon": "$(combine)"
        }
      ]
    },
    "commands": [
      {
        "command": "serverRunner.showView",
        "title": "Show Ninja Runner",
        "icon": "$(combine)"
      },
      {
        "command": "serverRunnerView.focus",
        "title": "Focus Server Runner View",
        "icon": "$(eye)"
      },
      {
        "command": "serverRunner.autoDetectProjects",
        "title": "🔍 Auto-Detect Projects",
        "icon": "$(search)"
      },
      {
        "command": "serverRunner.setupProjects",
        "title": "⚙️ Setup Projects",
        "icon": "$(gear)"
      },
      {
        "command": "serverRunner.resetConfiguration",
        "title": "🔄 Reset & Reconfigure",
        "icon": "$(refresh)"
      },
      {
        "command": "serverRunner.clearAllSelections",
        "title": "🗑️ Clear All Selections",
        "icon": "$(trash)"
      },
      {
        "command": "serverRunner.installDependencies",
        "title": "📦 Install Dependencies",
        "icon": "$(package)"
      },
      {
        "command": "serverRunner.installAllDependencies",
        "title": "📦 Download All Dependencies",
        "icon": "$(cloud-download)"
      },
      {
        "command": "serverRunner.stopAllServers",
        "title": "🛑 Stop All Servers",
        "icon": "$(stop)"
      },
      {
        "command": "serverRunner.startAllServers",
        "title": "🚀 Start All Servers",
        "icon": "$(run-all)"
      },
      {
        "command": "serverRunner.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "serverRunner.addServer",
        "title": "➕ Add New Server",
        "icon": "$(add)"
      },
      {
        "command": "serverRunner.editServer",
        "title": "✏️ Edit Server",
        "icon": "$(edit)"
      },
      {
        "command": "serverRunner.startDynamicServer",
        "title": "▶️ Start Server",
        "icon": "$(play)"
      },
      {
        "command": "serverRunner.retryServer",
        "title": "🔄 Retry Server",
        "icon": "$(refresh)"
      },
      {
        "command": "serverRunner.stopServer",
        "title": "🛑 Stop Server",
        "icon": "$(stop)"
      },
      {
        "command": "serverRunner.showStatusBar",
        "title": "📊 Show Status Bar",
        "icon": "$(dashboard)"
      },
      {
        "command": "serverRunner.nextServer",
        "title": "⏭️ Next Server",
        "icon": "$(arrow-right)"
      },
      {
        "command": "serverRunner.previousServer",
        "title": "⏮️ Previous Server",
        "icon": "$(arrow-left)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "serverRunner.autoDetectProjects",
          "when": "view == serverRunnerView",
          "group": "navigation@1"
        },
        {
          "command": "serverRunner.installAllDependencies",
          "when": "view == serverRunnerView",
          "group": "navigation@2"
        },
        {
          "command": "serverRunner.startAllServers",
          "when": "view == serverRunnerView",
          "group": "navigation@3"
        },
        {
          "command": "serverRunner.stopAllServers",
          "when": "view == serverRunnerView",
          "group": "navigation@4"
        },
        {
          "command": "serverRunner.resetConfiguration",
          "when": "view == serverRunnerView",
          "group": "settings@1"
        },
        {
          "command": "serverRunner.clearAllSelections",
          "when": "view == serverRunnerView",
          "group": "settings@2"
        },
        {
          "command": "serverRunner.refresh",
          "when": "view == serverRunnerView",
          "group": "settings@3"
        }
      ],
      "view/item/context": [
        {
          "command": "serverRunner.installDependencies",
          "when": "view == serverRunnerView && viewItem",
          "group": "inline@1"
        },
        {
          "command": "serverRunner.editServer",
          "when": "view == serverRunnerView && viewItem",
          "group": "inline@2"
        },
        {
          "command": "serverRunner.stopServer",
          "when": "view == serverRunnerView && viewItem",
          "group": "inline@3"
        }
      ],
      "commandPalette": [
        {
          "command": "serverRunner.addServer",
          "when": "view == serverRunnerView"
        },
        {
          "command": "serverRunner.installAllDependencies",
          "when": "view == serverRunnerView"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^16.18.126",
    "@types/vscode": "^1.50.0",
    "typescript": "^4.9.5"
  },
  "author": {
    "name": "akhilninja",
    "email": "akhil@example.com"
  },
  "license": "MIT",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  }
}
